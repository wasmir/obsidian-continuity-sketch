{
	"name": "obsidian-continuity-sketch",
	"version": "1.0.0",
	"description": "Obsidian plugin for Apple Continuity Sketch — draw on iPad, insert into notes",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@types/which": "^3.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.25.5",
		"tslib": "2.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"obsidian": "latest",
		"which": "^4.0.0"
	}
}
